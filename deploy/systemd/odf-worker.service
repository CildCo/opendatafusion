[Unit]
Description=ODF ETL Worker
After=network.target postgresql.service
[Service]
User=odf
WorkingDirectory=/opt/odf/impl
EnvironmentFile=/opt/odf/.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ODF_WORKER_ID=worker-1
ExecStart=/opt/odf/venv/bin/python -m odf.worker
MemoryMax=6G
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/odf
[Install]
WantedBy=multi-user.target
