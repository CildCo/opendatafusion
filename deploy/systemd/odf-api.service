[Unit]
Description=ODF API
After=network.target postgresql.service
[Service]
User=odf
WorkingDirectory=/opt/odf/impl
EnvironmentFile=/opt/odf/.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/odf/venv/bin/uvicorn odf.main:app --host 0.0.0.0 --port 18080
MemoryMax=3G
Restart=on-failure
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/odf
[Install]
WantedBy=multi-user.target
