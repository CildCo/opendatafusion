# Lakehouse data plane settings. Copy to values.env and edit.
# Every value here is rendered into the manifests by install.sh.

LAKE_BUCKET=warehouse
STORAGE_SIZE=50Gi
KAFKA_SIZE=20Gi
CDC_PG_SIZE=10Gi
CDC_DB=cdc
CDC_USER=cdc
# Leave empty to let install.sh generate one and store it here.
CDC_PASSWORD=
TRINO_HEAP=3G
# Floor for expire_snapshots. Trino refuses shorter retentions than this.
TRINO_EXPIRE_MIN_RETENTION=7d
FLINK_TASKMANGERS=1
SQL_GATEWAY_NODEPORT=30083
TRINO_NODEPORT=30080
FLINK_REST_NODEPORT=30081
NESSIE_NODEPORT=30082
S3_NODEPORT=30084
DEBEZIUM_NODEPORT=30085

# Ingress hosts. Point these at the node, or leave them as local names and add
# your own DNS records.
TRINO_HOST=trino.odf.local
FLINK_HOST=flink.odf.local
GRAFANA_HOST=grafana.odf.local

# External Secrets Operator. Turn on only when the operator and a
# ClusterSecretStore already exist in the cluster.
ENABLE_EXTERNAL_SECRETS=false
ESO_STORE=default
ESO_PREFIX=odf

# S3 credentials. Leave empty to let install.sh generate them.
LAKE_ACCESS_KEY=
LAKE_SECRET_KEY=

# Nessie version store. JDBC2 persists to the catalog database; IN_MEMORY
# survives no restart and is only for throwaway environments.
NESSIE_VERSION_STORE=JDBC2
NESSIE_PG_SIZE=5Gi
# Leave empty to let install.sh generate the catalog database password.
NESSIE_DB_PASSWORD=

IMAGE_SEAWEEDFS=chrislusf/seaweedfs:4.48
# Nessie publishes versioned tags; pin the one your registry mirrors.
IMAGE_NESSIE=ghcr.io/projectnessie/nessie:latest
IMAGE_TRINO=trinodb/trino:484
IMAGE_KAFKA=apache/kafka:3.9.0
IMAGE_POSTGRES=postgres:16-alpine
IMAGE_FLINK=flink:1.20-scala_2.12
# Built from images/spark-iceberg; set to your registry reference if you push it.
IMAGE_SPARK=odf/spark-iceberg:3.5.1
IMAGE_PROMETHEUS=prom/prometheus:v2.55.1
IMAGE_GRAFANA=grafana/grafana:11.3.0

# Kafka requires a stable cluster id for KRaft formatting.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk

IMAGE_DEBEZIUM=debezium/connect:3.0.0.Final

# Extra jars placed next to Flink's own libs. One URL per line.
FLINK_JARS="
https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-common/3.3.6/hadoop-common-3.3.6.jar
https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-client-api/3.3.6/hadoop-client-api-3.3.6.jar
https://repo1.maven.org/maven2/org/apache/hadoop/hadoop-client-runtime/3.3.6/hadoop-client-runtime-3.3.6.jar
https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-flink-runtime-1.20/1.7.1/iceberg-flink-runtime-1.20-1.7.1.jar
https://repo1.maven.org/maven2/org/apache/iceberg/iceberg-aws-bundle/1.7.1/iceberg-aws-bundle-1.7.1.jar
https://repo1.maven.org/maven2/org/apache/flink/flink-sql-connector-kafka/3.4.0-1.20/flink-sql-connector-kafka-3.4.0-1.20.jar
"

# Where the control plane exposes /metrics for Prometheus.
ODF_METRICS_TARGET=host.k3s.internal:18080

# Create the cluster-wide roles the control plane needs when it manages one
# namespace per project (ODF_K8S_TENANCY_ENABLED=true).
ENABLE_TENANCY=false

# Spark operator chart.
SPARK_OPERATOR_VERSION=2.5.2
